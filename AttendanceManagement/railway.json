{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "mkdir -p out && javac -cp \"lib/*\" src/App.java src/ValidationUtils.java -d out"
  },
  "deploy": {
    "startCommand": "java -cp \"out:lib/*\" App",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
